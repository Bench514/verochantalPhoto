generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PhotoCategory {
  PORTRAIT
  BOUDOIR
}

model Photo {
  id        String   @id @default(cuid())
  filename  String
  name      String
  alt       String   @default("")
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  categories PhotoCategoryLink[]
}

// A photo can belong to more than one category at once (Portrait + Boudoir).
// Position in the grid is independent per category, so order lives here
// rather than on Photo.
model PhotoCategoryLink {
  id       String        @id @default(cuid())
  photoId  String
  category PhotoCategory
  order    Int           @default(0)

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, category])
  @@index([category, order])
}

enum SessionStatus {
  PENDING
  GALLERY_SENT
  SUBMITTED
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())

  sessions     PhotoSession[]
  inviteTokens InviteToken[]
}

// A client's photo shoot. Access to its photos and selection is scoped to
// `clientId` everywhere this is queried — never trust a session id from the
// client alone without also checking ownership.
model PhotoSession {
  id            String        @id @default(cuid())
  clientId      String
  title         String
  // Nombre de photos retouchées incluses dans le forfait — sert au calcul de
  // la barre de progression et au message de dépassement dans le portail.
  includedCount Int           @default(15)
  sessionDate   DateTime      @default(now())
  status        SessionStatus @default(PENDING)
  submittedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  // Photo mise en avant côté portail client (héros de l'Espace Client) et
  // dans l'aperçu admin. Retombe sur la première photo de la séance quand
  // aucune couverture n'est choisie, ou que la photo choisie est supprimée
  // (onDelete: SetNull) — jamais de couverture "cassée".
  coverPhotoId String?

  client     User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  photos     SessionPhoto[] @relation("SessionPhotos")
  coverPhoto SessionPhoto?  @relation("SessionCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model SessionPhoto {
  id         String   @id @default(cuid())
  sessionId  String
  storageKey String
  filename   String
  sizeBytes  Int      @default(0)
  selected   Boolean  @default(false)
  favorite   Boolean  @default(false)
  createdAt  DateTime @default(now())

  session      PhotoSession   @relation("SessionPhotos", fields: [sessionId], references: [id], onDelete: Cascade)
  coverOfSessions PhotoSession[] @relation("SessionCover")

  @@index([sessionId])
}

// Single-use link sent by email so a client can set their own password.
model InviteToken {
  token     String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  sessionType String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
