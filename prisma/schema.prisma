generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PhotoCategory {
  PORTRAIT
  BOUDOIR
}

model Photo {
  id        String   @id @default(cuid())
  filename  String
  name      String
  alt       String   @default("")
  createdAt DateTime @default(now())

  categories PhotoCategoryLink[]
}

// A photo can belong to more than one category at once (Portrait + Boudoir).
// Position in the grid is independent per category, so order lives here
// rather than on Photo.
model PhotoCategoryLink {
  id       String        @id @default(cuid())
  photoId  String
  category PhotoCategory
  order    Int           @default(0)

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, category])
  @@index([category, order])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  sessionType String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
