# Base de données (SQLite). En local, un chemin relatif suffit (Prisma le
# résout par rapport à prisma/schema.prisma, donc "file:./dev.db" = fichier
# prisma/dev.db). En production sur Railway, utiliser un CHEMIN ABSOLU vers
# le volume persistant pour éviter toute ambiguïté, ex. file:/data/prod.db
DATABASE_URL="file:./dev.db"

# Dossier où sont stockées les photos uploadées par l'admin (résolu par
# rapport au dossier de travail du process Node, pas de schema.prisma).
# En local un dossier relatif suffit. Sur Railway: chemin absolu vers le
# volume persistant, ex. /data/uploads
UPLOADS_DIR="./uploads-dev"

# Identifiants admin (compte unique). Générer le hash avec:
# node -e "console.log(require('bcryptjs').hashSync('MOT_DE_PASSE', 10))"
# IMPORTANT: le hash bcrypt contient des "$" (ex. $2b$10$...). Next.js
# interprète $XXX comme une référence de variable dans les fichiers .env —
# échapper chaque "$" en "\$" ici, sinon le hash est silencieusement corrompu
# au chargement. (Ce piège ne s'applique qu'aux fichiers .env locaux — les
# variables saisies directement dans le dashboard Railway ne sont pas concernées.)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-a-real-bcrypt-hash"

# Secret utilisé pour signer le cookie de session admin (chaîne aléatoire longue)
SESSION_SECRET="replace-with-a-long-random-string"

# Lien Calendly pour les CTA de réservation (optionnel, sinon les boutons sont masqués)
CALENDLY_URL=""

# Coordonnées affichées sur la page Contact
NEXT_PUBLIC_CONTACT_EMAIL="bonjour@veroniquechantalphoto.ca"
NEXT_PUBLIC_CONTACT_PHONE=""

# Envoi d'email à la réception d'un message de contact (optionnel).
# Laisser vide pour désactiver — les messages restent visibles dans /admin/messages.
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""
