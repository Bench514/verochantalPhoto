# Base de données (PostgreSQL). En local: pointer vers un Postgres local
# (Docker, ou une base de dev créée sur Railway/Neon/Supabase). En
# production sur Railway: utiliser l'add-on Postgres, qui fournit
# automatiquement cette variable.
DATABASE_URL="postgresql://user:password@localhost:5432/verochantal"

# Stockage des photos (Cloudflare R2, compatible S3). Créer un bucket R2 et
# un jeton API (Compte Cloudflare > R2 > Manage API Tokens) avec les droits
# lecture/écriture sur ce bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Identifiants admin (compte unique). Générer le hash avec:
# node -e "console.log(require('bcryptjs').hashSync('MOT_DE_PASSE', 10))"
# IMPORTANT: le hash bcrypt contient des "$" (ex. $2b$10$...). Next.js
# interprète $XXX comme une référence de variable dans les fichiers .env —
# échapper chaque "$" en "\$" ici, sinon le hash est silencieusement corrompu
# au chargement. (Ce piège ne s'applique qu'aux fichiers .env locaux — les
# variables saisies directement dans le dashboard Railway ne sont pas concernées.)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-a-real-bcrypt-hash"

# Secret utilisé pour signer le cookie de session admin (chaîne aléatoire longue)
SESSION_SECRET="replace-with-a-long-random-string"

# URL publique du site, utilisée pour construire les liens d'invitation client
# envoyés par courriel. Par défaut: https://verochantalphotographie.ca. En local, mettre http://localhost:3000.
# APP_BASE_URL="http://localhost:3000"

# Lien Calendly pour les CTA de réservation (optionnel, sinon les boutons sont masqués)
CALENDLY_URL=""

# URL publique du site pour le SEO (balises canoniques, Open Graph, sitemap).
# Optionnel : par défaut https://verochantalphotographie.ca
NEXT_PUBLIC_SITE_URL=""

# Coordonnées affichées sur le site (optionnel : le courriel vaut
# info@verochantalphotographie.ca par défaut)
NEXT_PUBLIC_CONTACT_EMAIL="info@verochantalphotographie.ca"
NEXT_PUBLIC_CONTACT_PHONE=""

# Envoi d'email (contact, soumission de galerie client) via Resend
# (optionnel). Laisser vide pour désactiver — les messages restent visibles
# dans /admin/messages et /admin/sessions même sans envoi.
RESEND_API_KEY=""

# Boîte qui reçoit le contenu complet des communications (destinataire par
# défaut : info@verochantalphotographie.ca, la variable NEXT_PUBLIC_CONTACT_EMAIL
# ci-dessus). À ne définir que pour tester ailleurs temporairement.
CONTACT_NOTIFICATION_EMAIL=""

# Gmail personnel de Véro : reçoit seulement un rappel d'aller consulter
# info@, jamais le contenu des messages. Laisser vide pour désactiver ce rappel.
VERO_PING_EMAIL=""
